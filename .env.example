# Telegram Bot API token from @BotFather (required to start the bot)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF

# OpenAI API key for the Responses API (optional until task logic is wired)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Supabase Postgres (required to save confirmed tasks)
# Use the URI from Project Settings → Database (URI). Prefer the transaction pooler (port 6543).
# Prefix with postgresql+asyncpg:// so SQLAlchemy uses asyncpg.
# Example:
# postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Logging
LOG_LEVEL=INFO

# Deadline reminder scan interval in seconds (60–300). Default 120.
REMINDER_POLL_SECONDS=120
